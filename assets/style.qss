QMainWindow, QWidget {
    background: #f7f7f7;
    color: #222222;
    font-family: "Segoe UI";
    font-size: 13px;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #111111;
}

QLineEdit, QPlainTextEdit, QComboBox, QDateEdit, QDoubleSpinBox, QTableWidget, QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    padding: 5px;
}

QPushButton {
    background: #2d6cdf;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background: #245dbf;
}

QPushButton:pressed {
    background: #1e4ea1;
}

QTabBar::tab {
    background: #ececec;
    color: #333333;
    padding: 8px 14px;
    margin-right: 2px;
    border: 1px solid #d8d8d8;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #ffffff;
    font-weight: 600;
}

QHeaderView::section {
    background: #f0f0f0;
    color: #222222;
    padding: 6px;
    border: 1px solid #d8d8d8;
    font-weight: 600;
}

QTableWidget {
    gridline-color: #e3e3e3;
    alternate-background-color: #fafafa;
    selection-background-color: #dbe8ff;
    selection-color: #222222;
}

QMenuBar {
    background: #f7f7f7;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: #e9e9e9;
}

QMessageBox {
    background: #ffffff;
}

QLabel#summaryLabel {
    background: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    padding: 6px 10px;
}
